# Copy this file to .env.local (for local runs) and fill in real values.
# NEVER commit .env or .env.local. On Vercel, set these in Project Settings -> Environment Variables.

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Any long random string you invent (letters, digits, _ and - only). Telegram sends it back on every
# webhook call so the app can reject fake requests. Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Optional but recommended: comma-separated chat IDs allowed to use the bot (Meera's chat).
# Leave empty while setting up; the bot logs the chat ID of every message it receives.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Google Gemini (from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Optional model overrides. Defaults are documented in README.md.
GEMINI_MODEL_SCORING=
GEMINI_MODEL_TRANSCRIPTION=
GEMINI_MODEL_DRAFTING=
# Optional: drafting fallbacks, comma-separated (default gemini-3.8-flash,gemini-3.1-flash-lite).
GEMINI_DRAFTING_FALLBACK_MODELS=
# Optional: model tried when a classification model is overloaded or rate-limited.
GEMINI_FALLBACK_MODEL=

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
# Server-side only. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- News tuning (optional) ---
NEWS_RELEVANCE_THRESHOLD=0.70
NEWS_MAX_AGE_DAYS=30
